{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git switch*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git merge*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git worktree*)",
      "Bash(git ls-files*)",
      "Bash(git update-index*)",
      "Bash(git stash*)",
      "Bash(git restore*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(wc*)",
      "Bash(find*)",
      "Bash(rg*)",
      "Bash(grep*)",
      "Bash(sed -n*)",
      "Bash(diff*)",
      "Bash(mkdir*)",
      "Bash(cp*)",
      "Bash(mv*)",
      "Bash(test*)",
      "Bash(echo*)",
      "Bash(./scripts/verify.sh*)",
      "Bash(bash scripts/verify.sh*)",
      "Bash(npm run*)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npx*)",
      "Bash(pnpm*)",
      "Bash(node*)",
      "Bash(yarn*)",
      "Bash(python*)",
      "Bash(python3*)",
      "Bash(pytest*)",
      "Bash(pip install*)",
      "Bash(ruff*)",
      "Bash(mypy*)",
      "Bash(black*)",
      "Bash(composer*)",
      "Bash(vendor/bin/phpcs*)",
      "Bash(vendor/bin/phpcbf*)",
      "Bash(vendor/bin/phpstan*)",
      "Bash(php*)",
      "Edit(docs/**)",
      "Write(docs/**)",
      "Edit(content/**)",
      "Write(content/**)",
      "Edit(scripts/**)",
      "Write(scripts/**)",
      "Edit(.claude/**)",
      "Write(.claude/**)"
    ],
    "ask": [
      "Bash(gh*)",
      "Bash(docker*)",
      "Bash(az*)",
      "Bash(wp *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(ssh*)",
      "Bash(scp*)",
      "Bash(rsync*)",
      "Bash(wp db reset*)",
      "Bash(wp db drop*)",
      "Bash(mysql*)",
      "Bash(mariadb*)",
      "Bash(mysqldump*)",
      "Bash(dropdb*)",
      "Bash(curl:*|*sh*)",
      "Read(./migration.env)",
      "Read(./.env)",
      "Read(./**/*.pem)",
      "Read(./**/id_ed25519*)",
      "Read(./**/*serviceaccount*.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "$schema": "https://json.schemastore.org/claude-code-settings.json"
}
